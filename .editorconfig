# top-most EditorConfig file
root = true

[*]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
charset = utf-8
indent_style = space

[/**/__pycache__/**]
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
charset = unset
indent_style = unset
indent_size = unset

[*.py]
indent_size = 4

[{Makefile,**.mk}] # FIXME: Do I need Makefile on Windows?
# Use tabs for indentation (Makefiles require tabs)
indent_style = tab
